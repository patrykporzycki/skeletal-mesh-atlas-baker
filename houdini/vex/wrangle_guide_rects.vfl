int rect_count = chi("../rects");

for (int rect_index = 0; rect_index < rect_count; rect_index++)
{
    float center_x = chf(sprintf("../rect_center%dx", rect_index));
    float center_y = chf(sprintf("../rect_center%dy", rect_index));
    float size_x = chf(sprintf("../rect_size%dx", rect_index));
    float size_y = chf(sprintf("../rect_size%dy", rect_index));

    float min_x = max(0.0, center_x - size_x * 0.5);
    float min_y = max(0.0, center_y - size_y * 0.5);
    float max_x = min(1.0, center_x + size_x * 0.5);
    float max_y = min(1.0, center_y + size_y * 0.5);

    if (min_x >= max_x || min_y >= max_y) continue;

    int p0 = addpoint(0, set(0.0, 0.0, 0.0));
    int p1 = addpoint(0, set(0.0, 0.0, 0.0));
    int p2 = addpoint(0, set(0.0, 0.0, 0.0));
    int p3 = addpoint(0, set(0.0, 0.0, 0.0));

    int prim = addprim(0, "poly", array(p0, p1, p2, p3));

    string uv_channel = chs("../uv_channel");
    setvertexattrib(0, uv_channel, prim, 0, set(min_x, min_y, 0.0));
    setvertexattrib(0, uv_channel, prim, 1, set(max_x, min_y, 0.0));
    setvertexattrib(0, uv_channel, prim, 2, set(max_x, max_y, 0.0));
    setvertexattrib(0, uv_channel, prim, 3, set(min_x, max_y, 0.0));

    vector color = hsvtorgb((float)rect_index / (float)max(rect_count, 1), 0.8, 1.0);
    setpointattrib(0, "uv_guide_color", p0, color);
    setpointattrib(0, "uv_guide_color", p1, color);
    setpointattrib(0, "uv_guide_color", p2, color);
    setpointattrib(0, "uv_guide_color", p3, color);

}
