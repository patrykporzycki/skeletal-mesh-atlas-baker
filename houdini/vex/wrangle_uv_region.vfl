int rect_count = chi("../rects");
string material_name = s@fbx_material_name;
int pid = 0;
if (haspointattrib(0, "part_id")) {
    int p0 = primpoint(0, @primnum, 0);
    pid = point(0, "part_id", p0);
}
string material_key = sprintf("%d:%s", pid, material_name);

i@uv_region_id = -1;

for (int rect_index = 0; rect_index < rect_count; rect_index++)
{
    int mat_count = chi(sprintf("../mats%d", rect_index));

    for (int mat_index = 1; mat_index <= mat_count; mat_index++)
    {
        string assigned = chs(sprintf("../material_name%d_%d", rect_index, mat_index));

        if (assigned == material_key)
        {
            i@uv_region_id = rect_index + 1;
            break;
        }
    }

    if (i@uv_region_id != -1)
    {
        break;
    }
}