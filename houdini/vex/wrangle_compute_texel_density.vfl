int primitives = nprimitives(0);

int mode = chi("../target_density_mode");

if (mode == 0)
    return;

int rect_count = chi("../rects");
float region_world[], region_uv[];
resize(region_world, rect_count + 2);
resize(region_uv, rect_count + 2);

float world_size[], uv_size[];

int max_island_number = 0;
for (int i = 0; i < primitives; i++) {
    int c = prim(0, "island", i);
    if (c >= max_island_number) max_island_number = c + 1;
}

resize(world_size, max_island_number);
resize(uv_size, max_island_number);

vector bb_min[], bb_max[];
resize(bb_min, max_island_number);
resize(bb_max, max_island_number);

for (int j = 0; j < max_island_number; j++) {
    bb_min[j] = set(1e9, 1e9, 0);
    bb_max[j] = set(-1e9, -1e9, 0);
}

for (int k = 0; k < primitives; k++) {
    int c = prim(0, "island", k);
    float world_area = prim(0, "area", k);

    int pv[] = primvertices(0, k);

    float pts_length = len(pv);

    if (pts_length < 3)
        continue;

    for (int a = 0; a < pts_length; a++) {
        vector uv = vertex(0, "uv", pv[a]);
        bb_min[c] = min(bb_min[c], uv);
        bb_max[c] = max(bb_max[c], uv);
    }

    float a2 = 0.0;
    for (int l = 0; l < pts_length; l++) {
        vector u0 = vertex(0, "uv", pv[l]);
        vector u1 = vertex(0, "uv", pv[(l + 1) % (int)pts_length]);
        a2 += u0.x * u1.y - u1.x * u0.y;
    }
    float uv_area = abs(a2) * 0.5;

    world_size[c] += world_area;
    uv_size[c] += uv_area;

    int region_id = max(0, prim(0, "uv_region_id", k));

    if (region_id > 0) {
        region_world[region_id] += world_area;
        region_uv[region_id] += uv_area;
    }

    region_world[region_id] += world_area;
    region_uv[region_id] += uv_area;
}

if (mode == 1 || mode == 2) {
    float total_uv = sum(uv_size);
    float total_world = sum(world_size);

    if (total_uv <= 1e-12 || total_world <= 1e-12)
        return;


    float global_ref = total_uv / total_world;
    int resolution = chi("../resolution");
    float target_density = chf("../target_density") * 100.0;

    for (int p = 0; p < primitives; p++) {
        int c = prim(0, "island", p);

        if (uv_size[c] <= 1e-12 || world_size[c] <= 1e-12)
            continue;

        float ref = global_ref;

        float s = sqrt(ref / (uv_size[c] / world_size[c]));

        if (mode == 2)
            s = (target_density / float(resolution)) * sqrt(world_size[c] / uv_size[c]);

        vector pivot = (bb_min[c] + bb_max[c]) * 0.5;
        int pv[] = primvertices(0, p);

        for (int a = 0; a < len(pv); a++) {
            vector uv = vertex(0, "uv", pv[a]);
            setvertexattrib(0, "uv", p, a, pivot + (uv - pivot) * s);
        }
    }
}